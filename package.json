{
  "name": "mira",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mira — Voice-first AI Companion with realtime Vietnamese voice, memory, skills and optional 3D presence",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/restore-photoreal-assets.mjs && vite build",
    "preview": "vite preview",
    "test": "node --test scripts/runtime.test.mjs scripts/capability-policy.test.mjs scripts/host-action-policy.test.mjs",
    "benchmark:functional": "node scripts/functional-benchmark.mjs",
    "benchmark": "npm run benchmark:functional",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run check:architecture && npm run check:skills && tsc --noEmit && npm test && npm run benchmark:functional && vite build && npm run check:bundle && npm run check:artifact",
    "prune:pages": "node scripts/prune-pages-assets.mjs",
    "restore:photoreal": "node scripts/restore-photoreal-assets.mjs",
    "check:artifact": "node scripts/check-deploy-artifact.mjs",
    "check:pages": "node scripts/check-deploy-artifact.mjs --pages"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "@neondatabase/serverless": "^1.1.0",
    "@pixiv/three-vrm": "^3.5.3",
    "@react-three/fiber": "^8.18.0",
    "@ricky0123/vad-web": "^0.0.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@neon/config": "^1.8.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.1"
  }
}
