# Mira server-side configuration
# Copy to your local/server environment. Never commit real keys.

# Brain + semantic memory (server only)
GEMINI_API_KEY=
# Optional override; otherwise Mira tries a resilient Flash fallback chain.
GEMINI_MODEL=

# Neon/Postgres memory store
DATABASE_URL=

# Cloud TTS proxy (optional; Web Speech / local Edge / VieNeu remain fallbacks)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Browser BYOK is intentionally DEV-only and is configured from Developer Labs.
# Production browser builds do not read VITE_LLM_API_KEY.
