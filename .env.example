# Mira server-side configuration
# Copy to your local/server environment. Never commit real keys.

# ── Brain Gateway ─────────────────────────────────────────────
# auto | gemini | openai | anthropic
# auto = use the first configured provider in Gemini → OpenAI → Anthropic order.
MIRA_BRAIN_PROVIDER=auto
# Optional comma-separated fallback order when a primary provider is selected.
# Example: openai,gemini
MIRA_BRAIN_FALLBACKS=

# Gemini — also powers semantic-memory embeddings/fact distillation.
GEMINI_API_KEY=
# Optional; otherwise Mira uses the existing Flash fallback chain.
GEMINI_MODEL=

# OpenAI Responses API — model is explicit so repo code never hardcodes a potentially stale model id.
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic Messages API — model is explicit for the same reason.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── Memory ────────────────────────────────────────────────────
# Server-only 32+ byte key: required for cloud session scopes; DO NOT prefix VITE_
MIRA_MEMORY_SESSION_KEY=
# Cloud memory requires a Neon DATABASE_URL; local Desktop/GitHub Pages do not.
DATABASE_URL=
# Server-only HMAC key for billable API quota identifiers, never expose to browser
MIRA_QUOTA_HMAC_KEY=
# Set require-neon after shared quota storage is connected; rejects paid AI requests without it.
# MIRA_AI_QUOTA_MODE=require-neon

# ── Cloud TTS proxy (optional) ────────────────────────────────
# Production voice is ElevenLabs-only via a server-side gateway; no silent browser/local provider fallback.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Public URL only; safe for the browser. The API key stays on the backend.
VITE_MIRA_TTS_URL=

# Browser BYOK is intentionally DEV-only and is configured from Developer Labs.
# Production browser builds do not read VITE_LLM_API_KEY.

# Optional verified market quote provider for Mira Finance.
TWELVE_DATA_API_KEY=
