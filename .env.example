# Mira server-side configuration
# Copy to your local/server environment. Never commit real keys.

# ── Brain Gateway ─────────────────────────────────────────────
# auto | gemini | openai | anthropic
# auto = use the first configured provider in Gemini → OpenAI → Anthropic order.
MIRA_BRAIN_PROVIDER=auto
# Optional comma-separated fallback order when a primary provider is selected.
# Example: openai,gemini
MIRA_BRAIN_FALLBACKS=

# Gemini — also powers semantic-memory embeddings/fact distillation.
GEMINI_API_KEY=
# Optional; otherwise Mira uses the existing Flash fallback chain.
GEMINI_MODEL=

# OpenAI Responses API — model is explicit so repo code never hardcodes a potentially stale model id.
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic Messages API — model is explicit for the same reason.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── Memory ────────────────────────────────────────────────────
DATABASE_URL=

# ── Cloud TTS proxy (optional) ────────────────────────────────
# Web Speech / local Edge / VieNeu remain fallbacks.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Browser BYOK is intentionally DEV-only and is configured from Developer Labs.
# Production browser builds do not read VITE_LLM_API_KEY.
